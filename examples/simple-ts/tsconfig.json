{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@useago/sdk/widget": ["../../src/widget/index.ts"],
      "@useago/sdk": ["../../src/index.ts"]
    }
  },
  "include": ["src/**/*.ts"]
}
